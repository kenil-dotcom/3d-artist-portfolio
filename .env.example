# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# --- Database (Task 1.3) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio?schema=public

# --- Auth (Task 9.1) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32-byte-random-string

# --- Object storage / CDN (Task 5.5) ---
S3_REGION=us-east-1
S3_BUCKET=portfolio-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=
CDN_BASE_URL=

# --- Rate limiting (Task 7.1) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Captcha (Task 7.3) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (Task 7.6) ---
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=portfolio@example.com
NOTIFICATION_TO_EMAIL=artist@example.com
